# 이 파일을 .env 로 복사해서 사용 (cp .env.example .env)
PORT=2567
# debug | info | warn | error
LOG_LEVEL=debug
# 채널 정원 (기본 70). 채널 자동 분할을 시험할 때 2 정도로 줄인다
# MAX_CLIENTS=2
# 맵 등 에셋 폴더 (기본: 리포 루트 assets/)
# ASSETS_DIR=../../assets
# SQLite 파일 (기본: apps/server/data.db)
# DB_PATH=data.db
# 입장 토큰 서명 키. 운영에서는 반드시 지정 (openssl rand -hex 32). 개발에서는 비워 두면 개발용 키를 쓴다
# AUTH_SECRET=
# 입장 토큰 유효 시간 (초, 기본 12시간)
# TOKEN_TTL_SEC=43200
