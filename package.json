{
  "name": "everyones-park",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:wsl": "CLIENT_PORT=15173 pnpm -r --parallel dev",
    "preview": "pnpm build && pnpm -r --parallel preview",
    "preview:wsl": "pnpm build && CLIENT_PORT=15173 pnpm -r --parallel preview",
    "client:wsl": "CLIENT_PORT=15173 pnpm --filter @park/client dev",
    "deploy:phone": "bash scripts/deploy-phone.sh",
    "deploy:stop": "pm2 delete deploy/ecosystem.config.cjs",
    "docker:up": "docker compose -f docker/compose.yml up --build -d",
    "docker:down": "docker compose -f docker/compose.yml down",
    "docker:logs": "docker compose -f docker/compose.yml logs -f",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "gen:map": "tsx scripts/gen-placeholder-map.ts",
    "gen:character": "tsx scripts/gen-placeholder-character.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "pm2": "7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
