!packages/shared/data/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# 3D 시제품 작업 폴더 (로컬 전용). 운영 소스는 apps/client/park3d/
winter-village/

